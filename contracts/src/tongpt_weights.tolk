fun defaultTonGptPromptEmbeddings(): Cell<TonGptPromptEmbeddings> {
    return TonGptPromptEmbeddings {
        byteEmbeddings: defaultTonGptByteEmbeddings(),
        positionEmbeddings: defaultTonGptPositionEmbeddings(),
        pairEmbeddings: defaultTonGptPairEmbeddings(),
    }.toCell();
}

fun defaultTonGptOutputWeights(): Cell<TonGptOutputWeights> {
    return TonGptOutputWeights {
        tokenEmbeddings: defaultTonGptTokenEmbeddings(),
        heads: defaultTonGptHeads(),
        tokenBytes: defaultTonGptTokenBytes(),
    }.toCell();
}

fun defaultTonGptModelStorage(): Cell<TonGptModelStorage> {
    return TonGptModelStorage {
        prompt: defaultTonGptPromptEmbeddings(),
        output: defaultTonGptOutputWeights(),
    }.toCell();
}

fun defaultTonGptStorage(owner: address): TonGptStorage {
    return TonGptStorage {
        owner,
        nextJobId: 1,
        maxContext: 80,
        maxGenerate: 8,
        eosToken: 0,
        model: defaultTonGptModelStorage(),
        jobs: [],
        isPaused: false,
    };
}

